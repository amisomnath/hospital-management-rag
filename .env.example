APP_NAME=Hospital RAG Assistant
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL with the pgvector extension is the primary database/vector store.
DATABASE_URL=postgresql+psycopg://hospital_user:replace-with-a-strong-database-password@localhost:5432/hospital_db

SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# sentence_transformers is the intended Hugging Face backend.
# Set hash only for lightweight tests without a model download.
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# cpu = portable/default; cuda or cuda:0 = NVIDIA; mps = Apple Silicon.
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=384

# retrieval_only needs no generative API key.
# Other options: local_hf, groq
LLM_PROVIDER=retrieval_only
LOCAL_LLM_MODEL=google/flan-t5-base
LOCAL_LLM_DEVICE=-1
LOCAL_LLM_MAX_NEW_TOKENS=256

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CHUNK_SIZE=220
CHUNK_OVERLAP=40
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.35

VECTOR_INDEX_PATH=storage/vector_index/hospital.index
VECTOR_METADATA_PATH=storage/vector_index/metadata.json
VECTOR_NUMPY_PATH=storage/vector_index/hospital_vectors.npz
KNOWLEDGE_BASE_PATH=data/knowledge_base
KNOWLEDGE_UPLOAD_PATH=data/knowledge_base/uploads

SAVE_CHAT_HISTORY=true
WEBSOCKET_MAX_MESSAGE_CHARS=4000
DOCUMENT_MAX_UPLOAD_MB=15
DOCUMENT_MAX_BATCH_FILES=50

# JSON list. Use explicit trusted origins outside local development.
CORS_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]

# Used by Docker Compose only.
POSTGRES_DB=hospital_db
POSTGRES_USER=hospital_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=5433
DOCKER_EMBEDDING_DEVICE=cpu
